{
  "name": "home-renovation",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:worker": "pnpm --filter api worker:dev",
    "dev:app": "pnpm --filter app dev",
    "dev": "pnpm dev:api & pnpm dev:worker & pnpm dev:app",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter api migration:run",
    "db:seed": "rm -rf api/storage/reports && pnpm --filter api seed",
    "db:reset": "docker compose down -v && pnpm infra:up && pnpm db:migrate && pnpm db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.9.0"
}
